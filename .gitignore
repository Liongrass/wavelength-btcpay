## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Editor files
.vscode/
*.swp
*.swo

# Claude Code local overlay
CLAUDE.local.md

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*~

# Logs
logs/
*.log

# Databases
*.sql
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets/

# Docker volumes and data
docker-compose.override.yml
postgres_data/
btcpayserver_data/
btcpay_data/
wavelength-data/

# Build artifacts - plugin deployment directory
plugins/

# scripts/build-plugin.sh output
/build/
/packaged/

# Native waved/wavecli binaries (fetched at publish time or placed manually for dev)
BTCPayServer.Plugins.Wavelength/Native/**/*
!BTCPayServer.Plugins.Wavelength/Native/**/.gitkeep
