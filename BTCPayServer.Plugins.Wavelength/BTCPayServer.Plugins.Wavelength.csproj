<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Plugin build settings -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Enable XML documentation for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Plugin Metadata -->
    <Product>Wavelength</Product>
    <Description>Adds wavelength, a self-custodial Ark/Lightning/on-chain wallet, to BTCPay Server as a Lightning wallet backend.</Description>
    <Version>0.1.0</Version>
    <Authors>Lightning Labs</Authors>
    <Company>Lightning Labs</Company>
    <PackageProjectUrl>https://github.com/lightninglabs/wavelength-btcpay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lightninglabs/wavelength-btcpay</RepositoryUrl>
    <PackageTags>btcpay;wavelength;ark;lightning;bitcoin;payments</PackageTags>

    <!--
      TODO: mirror bark-btcpay's DownloadBarkNativeForPublish MSBuild target once wavelength
      has tagged releases with published waved/wavecli binaries: pin a WavedNativeVersion,
      download the linux-x64 (and other RID) binaries into Native/<rid>/ with SHA256
      verification, BeforeTargets="ComputeFilesToPublish". Until then, binaries must be
      placed manually under Native/<rid>/ for local development (see Services/WavedProcessManager.cs).
    -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BTCPayServer.Plugins.Wavelength.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- BTCPay Server dependency (submodule) - exclude from plugin output, host already provides it -->
    <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      gRPC client for waved. Protos/ is vendored (not a submodule) from
      lightninglabs/wavelength - see Protos/VENDORED_COMMIT for the exact source
      commit and scripts/check-proto-drift.sh for the CI staleness check.
    -->
    <PackageReference Include="Grpc.Tools" Version="2.82.0" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <Protobuf Include="Protos\**\*.proto" GrpcServices="Client" ProtoRoot="Protos" />
  </ItemGroup>

  <!-- Include native waved/wavecli binaries in build output, once present -->
  <ItemGroup>
    <None Include="Native\**\*" Condition="Exists('Native')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Native\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
