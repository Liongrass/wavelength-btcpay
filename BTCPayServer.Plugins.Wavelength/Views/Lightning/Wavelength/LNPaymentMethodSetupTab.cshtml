@model BTCPayServer.Models.StoreViewModels.LightningNodeViewModel
@using BTCPayServer.Plugins.Wavelength.Services
@inject WavedStoreTokenProtector TokenProtector
@inject WavedConfiguration WavedConfig
@{
    if (Model.CryptoCode != "BTC")
    {
        return;
    }
    // A store's real ID is often visible to anyone with even minor access to that store (it's in
    // the URL) - the connection string uses an opaque token instead, so reaching this store's
    // waved instance requires actually possessing this generated string, not just knowing its ID.
    // See WavedStoreTokenProtector's doc comment.
    //
    // GetOrCreateTokenAsync (not a fresh encryption of the store ID on every render, which is what
    // this page used to do): the token is an HMAC over the store ID under a seed persisted per
    // store, so this page shows the SAME string on every visit, and the string it shows is the one
    // that currently works. Encrypting the store ID per render produced a different, equally
    // valid-looking string every time, none of which could be told apart from one that had since
    // been revoked. Calling this does persist a seed for a store that had none, which is harmless
    // on its own: a seed grants nothing until a token derived from it is saved as a connection
    // string, and no token can be derived from a seed without it.
    var token = await TokenProtector.GetOrCreateTokenAsync(Model.StoreId);

    // "server" (waved's own Ark operator address) is entirely optional and deliberately left out of
    // every sample below - see WavedOperatorServer's class doc comment for why an earlier version of
    // this page got that backwards. defaultServer is only used in the one line further down that
    // shows what setting a CUSTOM operator looks like, as a real, working example value rather than
    // a placeholder - it matches whatever network this store's wallet would actually run on if
    // "network" were left unset (WavedConfig.Network, itself BTCPay's own ambient network unless
    // overridden).
    var defaultServer = WavedOperatorServer.DefaultFor(WavedConfig.Network);
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const customNodeAccordion = document.getElementById("CustomNodeSupport");
        const template = document.getElementById("wavelength-ln-setup");
        if (customNodeAccordion && template) {
            customNodeAccordion.appendChild(template.content.cloneNode(true));
        }
    });
</script>

<template id="wavelength-ln-setup">
    <div class="accordion-item">
        <h2 class="accordion-header" id="CustomWavelengthHeader">
            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#CustomWavelengthContent" aria-controls="CustomWavelengthContent" aria-expanded="false">
                <span><strong>Wavelength</strong> <span>waved</span></span>
                <vc:icon symbol="caret-down"/>
            </button>
        </h2>
        <div id="CustomWavelengthContent" class="accordion-collapse collapse" aria-labelledby="CustomWavelengthHeader" data-bs-parent="#CustomNodeSupport">
            <div class="accordion-body">
                <p class="mb-2">
                    Wavelength can be run with either Lightweight (<code>lwwallet</code>) or Neutrino
                    (<code>btcwallet</code>) as a wallet backend from a store's own connection string. You may
                    choose between <code>mainnet</code>, <code>signet</code>, <code>testnet</code>,
                    <code>simnet</code>, and <code>regtest</code>.<br />
                    Each store may run its own <code>waved</code> instance on a separate network with a
                    separate backend.<br />
                    Please note that before switching between wallets or networks on the same store, the
                    wallet has to be emptied and deleted.<br />
                    (waved also supports an LND wallet backend, but it isn't offered here: it needs an lnd
                    host and macaroon, and letting a store's own connection string set those would let it
                    exfiltrate that macaroon to a server of its choosing - the same risk this allowlist exists
                    to close off.)
                </p>
                <ul class="pb-2">
                    <li class="mb-2">
                        <div class="text-muted small">Wallet: Lightweight</div>
                        <code><b>type=</b>wavelength;<b>token=</b>@token</code>
                    </li>
                    <li class="mb-2">
                        <div class="text-muted small">Wallet: Lightweight (signet)</div>
                        <code><b>type=</b>wavelength;<b>token=</b>@token;<b>network=</b>signet</code>
                    </li>
                    <li class="mb-2">
                        <div class="text-muted small">Wallet: Neutrino</div>
                        <code><b>type=</b>wavelength;<b>token=</b>@token;<b>wallet.type=</b>btcwallet</code>
                    </li>
                </ul>
                <p class="my-2">
                    This token is unique to this store - do not share it or reuse it for another store, and
                    generate a fresh connection string here if you ever need to move this wallet.
                </p>
                <p class="my-2">
                    <code>server</code> is this store's Ark operator address. Leave it out, as above, and
                    <code>waved</code> uses its own built-in default for whichever <code>network</code> you
                    chose. Only set it if you want to point this store at a <em>different</em> operator, e.g.
                    <code><b>type=</b>wavelength;<b>token=</b>@token;<b>server=</b>@defaultServer</code> - if
                    you do, it needs an explicit <code>http://</code> or <code>https://</code> scheme even
                    though <code>waved</code> itself only ever dials the bare <code>host:port</code> form
                    (the scheme is stripped before it reaches <code>waved</code>): BTCPay's own save-time
                    check additionally requires the value to parse as an absolute URL for anyone who isn't a
                    server administrator. It also may not be a local or private address - keep it matching
                    whatever <code>network</code> you end up using, since <code>waved</code> does not
                    cross-check the two for you.
                </p>
                <p class="my-2">
                    Besides <code>token</code>, a reviewed set of additional <code>waved</code> flags can be
                    added the same way - e.g. <code>network</code>, <code>wallet.esploraurl</code>,
                    <code>wallet.feeurl</code>, <code>wallet.recoverywindow</code>, <code>debuglevel</code>,
                    <code>allow-mainnet</code>, the round fee/refresh knobs, and the <code>oor.*</code>/
                    <code>unroll.*</code> tuning namespaces. They're passed straight through as
                    <code>--flag value</code> on this store's <code>waved</code> process.
                    Anything not on that list is rejected rather than passed through - this plugin manages this
                    store's isolation and auth (<code>datadir</code>, TLS/macaroon material, its listen address)
                    itself, and several other <code>waved</code> flags would otherwise let a connection string
                    read or write an arbitrary file on this server, or expose a debug endpoint, rather than just
                    configure the wallet - see <code>WavedAllowedFlags</code> in the plugin source for the exact
                    list and the reasoning behind it. Changing flags on an already-running store takes effect on
                    its next restart, not immediately.
                </p>
                <!-- TODO: link to a Wavelength settings/setup page once one exists, mirroring
                     bark-btcpay's "Bark settings" link, so users can initialize/back up the
                     store's wallet before pointing BTCPay's Lightning connection at it. -->
            </div>
        </div>
    </div>
</template>
