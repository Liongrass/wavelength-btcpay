@model WavelengthWalletViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("Wavelength-Index", StringLocalizer["Wavelength Wallet"]).SetCategory("Wavelength"));
}

<h2 class="mb-3">@ViewData["Title"]</h2>
<partial name="_StatusMessage" />

@if (!string.IsNullOrEmpty(Model.StartupError))
{
    <div class="alert alert-danger">
        <strong>waved failed to start:</strong>
        <pre class="mb-0 mt-1" style="white-space: pre-wrap;">@Model.StartupError</pre>
    </div>
}
else if (!Model.IsRunning)
{
    <div class="alert alert-warning">
        This store's <code>waved</code> instance is not running. It starts automatically the
        first time it's needed - reload this page, or check
        <a asp-action="Advanced" asp-route-storeId="@Model.StoreId">Advanced</a> for details if
        this persists.
    </div>
}

@if (Model.IsRunning && !Model.WalletExists)
{
    @if (Model.IsCreatingWallet)
    {
        <meta http-equiv="refresh" content="10">
        <div class="widget text-center py-5">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Creating...</span>
            </div>
            <h5 class="mb-3">Creating your wallet&hellip;</h5>
            <p class="text-muted mb-0 mx-auto" style="max-width: 480px;">
                This can take a little while - this page will refresh automatically until it's
                ready, then show your new recovery phrase. Please don't close this tab.
            </p>
            @if (Model.SyncBlockHeight is not null || Model.SyncWalletState is not null)
            {
                <p class="text-muted small mb-0 mt-2 mx-auto" style="max-width: 480px;">
                    Chain backend:
                    @if (Model.SyncBlockHeight is not null)
                    {
                        <text>block height @Model.SyncBlockHeight.Value.ToString("N0")</text>
                    }
                    @if (Model.SyncWalletState is not null)
                    {
                        <text>, wallet state <code>@Model.SyncWalletState</code></text>
                    }
                    @if (Model.SyncBlockHeight is 0)
                    {
                        <text> - still syncing, this is normal for a fresh Neutrino/btcwallet backend.</text>
                    }
                </p>
            }
        </div>
    }
    else
    {
        <div class="widget text-center py-5">
            <h5 class="mb-3">This store doesn't have a Wavelength wallet yet</h5>
            <p class="text-muted mb-4 mx-auto" style="max-width: 480px;">
                Creating one generates a new recovery phrase, shown to you exactly once right after
                you click below - write it down before you leave this page. It is never stored
                anywhere else, so if you lose it, it cannot be recovered.
            </p>
            <form method="post" asp-action="CreateWallet" asp-route-storeId="@Model.StoreId" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Create wallet</button>
            </form>
        </div>
    }
}

@if (Model.IsRunning && Model.WalletExists)
{
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="fs-2 fw-bold">@Model.ConfirmedSat.ToString("N0") sats</span>
            @if (Model.PendingInSat > 0)
            {
                <span class="text-muted d-block">+ @Model.PendingInSat.ToString("N0") sats incoming</span>
            }
            @if (Model.PendingOutSat > 0)
            {
                <span class="text-muted d-block">- @Model.PendingOutSat.ToString("N0") sats outgoing</span>
            }
            @if (Model.CreditAvailableSat > 0)
            {
                <span class="text-muted d-block">+ @Model.CreditAvailableSat.ToString("N0") sats credit available</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Send" asp-route-storeId="@Model.StoreId" class="btn btn-primary">Send</a>
            <a asp-action="Receive" asp-route-storeId="@Model.StoreId" class="btn btn-outline-secondary">Receive</a>
            <a asp-action="Advanced" asp-route-storeId="@Model.StoreId" class="btn btn-outline-secondary">Advanced</a>
        </div>
    </div>

    <div class="widget">
        <h6 class="mb-3">Activity</h6>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Note</th>
                        <th>Status</th>
                        <th class="text-end">Amount</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Activity.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No activity yet</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entry in Model.Activity)
                        {
                            <tr>
                                <td class="text-muted">@entry.UpdatedAt.ToLocalTime().ToString("g")</td>
                                <td>@entry.Kind</td>
                                <td class="text-muted">@entry.Note</td>
                                <td>
                                    @{
                                        var badgeClass = entry.Status switch
                                        {
                                            "Complete" => "bg-success",
                                            "Pending" => "bg-info",
                                            "Failed" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@entry.Status</span>
                                </td>
                                <td class="text-end fw-semibold @(entry.AmountSat > 0 ? "text-success" : "")">
                                    @entry.AmountSat.ToString("N0") sats
                                </td>
                                <td>
                                    <span class="text-muted font-monospace d-inline-block" style="width: 6ch; margin-right: 5px;">@(entry.Id.Length > 6 ? entry.Id[..6] : entry.Id)</span>
                                    <button type="button" class="btn btn-link p-0 clipboard-button" data-clipboard="@entry.Id" title="Copy ID">
                                        <vc:icon symbol="actions-copy" />
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
