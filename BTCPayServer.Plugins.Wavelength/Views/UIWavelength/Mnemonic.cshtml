@using BTCPayServer.Abstractions.Models
@model WavelengthMnemonicViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("Wavelength-Mnemonic", StringLocalizer["Wallet Recovery Phrase"]).SetCategory("Wavelength"));
    var words = Model.Mnemonic?.Split(' ', StringSplitOptions.RemoveEmptyEntries) ?? [];
}

<h2>Wallet Recovery Phrase</h2>

@if (Model.Mnemonic is null)
{
    <div class="alert alert-warning">
        This recovery phrase has already been acknowledged (or was never generated for this
        store) and is not stored anywhere - it cannot be shown again. If you did not record it,
        the wallet's on-disk data is still the only copy that exists.
    </div>
    <a asp-action="Index" asp-route-storeId="@Model.StoreId">Back to Wavelength</a>
}
else
{
    <div class="alert alert-danger">
        Below is your wallet's seed phrase. It can be used to recover your funds in case of a
        fatal error. It will keep being shown, here and on the dashboard, until you confirm below
        that you've written it down by hand on a piece of paper - it is never stored anywhere.
    </div>

    <p class="mb-3">
        Write this store's name and ID down alongside the words below, so you know which wallet
        this phrase belongs to if you ever need to use it:<br />
        <strong>@Model.StoreName</strong> <span class="text-muted">(@Model.StoreId)</span>
    </p>

    <div class="widget mb-4" style="max-width: 640px;">
        <div class="row text-center gy-2">
            @for (var col = 0; col < 4; col++)
            {
                <div class="col-3">
                    @for (var i = col * 6; i < col * 6 + 6 && i < words.Length; i++)
                    {
                        <div class="mb-2">
                            <span class="text-muted">@(i + 1).</span>
                            <strong>@words[i]</strong>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <form method="post" asp-action="AcknowledgeMnemonic" asp-route-storeId="@Model.StoreId" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">I wrote it down.</button>
    </form>
}
