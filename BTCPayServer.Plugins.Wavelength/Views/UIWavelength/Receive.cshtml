@model WavelengthReceiveViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("Wavelength-Receive", StringLocalizer["Receive"]).SetCategory("Wavelength"));
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.RateErrorMessage))
{
    <div class="alert alert-warning" style="max-width: 400px;">@Model.RateErrorMessage</div>
}

<form method="post" class="mb-4" style="max-width: 400px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Amount</label>
        <div class="input-group">
            <input asp-for="Amount" type="number" min="0" step="any" class="form-control" id="Amount" />
            <input asp-for="Currency" class="form-control" style="max-width: 6.5rem;" id="Currency" currency-selection />
        </div>
        <div class="form-text" id="rate-reference"></div>
        <div class="form-text" id="rate-conversion"></div>
    </div>
    <div class="mb-3">
        <label asp-for="Memo" class="form-label">Memo (optional)</label>
        <input asp-for="Memo" class="form-control" maxlength="200" />
    </div>
    <button type="submit" class="btn btn-primary">Create invoice</button>
    <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-link">Back</a>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var amountInput = document.getElementById("Amount");
        var currencyInput = document.getElementById("Currency");
        var referenceEl = document.getElementById("rate-reference");
        var conversionEl = document.getElementById("rate-conversion");
        if (!amountInput || !currencyInput) return;

        var state = {
            rate: @Html.Raw(Model.Rate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null"),
            currency: @Safe.Json(Model.RateCurrency ?? ""),
            divisibility: @Model.RateDivisibility
        };
        var rateUrl = @Safe.Json(Url.Action("ReceiveRate", new { storeId = Model.StoreId }));

        function isSats(value) {
            return (value || "").trim().toLowerCase() === "sats";
        }

        function updateReference() {
            referenceEl.textContent = state.rate
                ? ("1 BTC ≈ " + state.rate.toFixed(2) + " " + state.currency)
                : "";
        }

        function updateConversion() {
            var amount = parseFloat(amountInput.value);
            if (!amount || !state.rate) { conversionEl.textContent = ""; return; }
            if (isSats(currencyInput.value)) {
                var fiat = (amount / 100000000) * state.rate;
                conversionEl.textContent = "≈ " + fiat.toFixed(state.divisibility) + " " + state.currency;
            } else {
                var sats = Math.round((amount / state.rate) * 100000000);
                conversionEl.textContent = "≈ " + sats.toLocaleString() + " sats";
            }
        }

        function refreshRate() {
            fetch(rateUrl + "?currency=" + encodeURIComponent(currencyInput.value || "sats"))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    state.rate = data.rate;
                    state.currency = data.currency;
                    state.divisibility = data.divisibility;
                    updateReference();
                    updateConversion();
                });
        }

        amountInput.addEventListener("input", updateConversion);
        currencyInput.addEventListener("change", refreshRate);
        updateReference();
        updateConversion();
    });
</script>

@if (!string.IsNullOrEmpty(Model.Invoice))
{
    <div class="widget" style="max-width: 400px;">
        <div class="text-center p-3 bg-white rounded mb-3">
            <div id="receive-qr"></div>
        </div>
        <label class="form-label text-muted text-uppercase small">Invoice</label>
        <vc:truncate-center text="@Model.Invoice" padding="15" elastic="true" classes="form-control-plaintext w-100" />
    </div>

    <script src="~/js/qrcode.js" asp-append-version="true"></script>
    <script>
        new QRCode(document.getElementById("receive-qr"), {
            text: @Safe.Json(Model.Invoice),
            width: 256,
            height: 256,
            useSVG: true,
            correctLevel: QRCode.CorrectLevel.M
        });
    </script>
}
